# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional CORS allow-list (comma-separated). Defaults to CLIENT_URL when unset.
# Production subdomain example:
# CLIENT_URL=https://mickys.yourdomain.com
# CORS_ORIGINS=https://mickys.yourdomain.com

# Database
MONGO_URI=mongodb://127.0.0.1:27017/mickys_po

# JWT — In production the server REFUSES to start unless both secrets are set,
# at least 32 chars, different from each other, and not the dev defaults.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Email — Resend is used when RESEND_API_KEY is set; otherwise falls back to SMTP.
# Get a key at https://resend.com/api-keys. The EMAIL_FROM domain must be
# verified in Resend (or use onboarding@resend.dev for quick testing).
RESEND_API_KEY=
EMAIL_FROM="Micky's Sales <contact@mickys.in>"

# SMTP fallback (used only when RESEND_API_KEY is empty).
# Defaults below are for Hostinger Business Email. Note: Hostinger Free Business
# Email allows 100 sends / 24h per mailbox and 25 MB max attachment.
# Can also be configured from the Admin > Settings screen.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@mickys.in
SMTP_PASS=

# Uploads
MAX_FILE_SIZE_MB=10
