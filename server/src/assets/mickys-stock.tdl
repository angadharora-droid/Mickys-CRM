;; =====================================================================
;;  Mickys CRM  -  Tally Prime Stock Data Export TDL
;; ---------------------------------------------------------------------
;;  What this does:
;;    * Defines a report "MickysStockReport" that the CRM backend can
;;      pull over Tally's XML/HTTP gateway (the port shown in
;;      Client/Server configuration - 9001 in our setup).
;;    * For every stock item it returns: group, category, base unit,
;;      the item's alias (the CRM product code, e.g. SFG-006-250) and
;;      part number, opening qty/rate/value, inward qty/value, outward
;;      qty/value, closing qty/rate/value, standard cost and standard
;;      price.
;;    * It also returns every vendor (ledgers under Sundry Creditors)
;;      as <VENDOR> elements and every customer (ledgers under Sundry
;;      Debtors) as <CUSTOMER> elements: name and group, sub-groups
;;      included.
;;    * It also returns recent sales invoices as <SALESINVOICE>
;;      elements (number, date, party, reference, order no(s),
;;      narration, amount) so the CRM can match each invoice to the
;;      sales order whose number accounts wrote on it.
;;    * After every push it also syncs sales orders with the CRM: it
;;      reports the sales orders Tally holds, then collects the confirmed
;;      CRM orders due in Tally and creates each one as a Sales Order
;;      voucher (Tally numbers it; Order no. = the CRM number, TEST/<no.>
;;      in test mode). Set up in the CRM: Sales Order Settings > Orders
;;      into Tally. "Mickys CRM Orders" in Gateway of Tally lists them,
;;      Ctrl+F9 there runs the order sync at once.
;;    * Opening figures respect SVFROMDATE and closing figures respect
;;      SVTODATE sent in the request, so the same report also answers
;;      "stock as on <date>".
;;
;;  How to get the current file (always up to date, key filled in):
;;    Open this URL in any browser and save/copy the text:
;;      https://api.mickys-crm.centrepointgroup.in/api/stock/tdl?key={{TALLY_SYNC_KEY}}
;;    (TallyPrime's Manage Local TDLs screen only accepts local file
;;    paths - it rejects URLs - so the URL is the download source, not
;;    the load path.)
;;
;;  How to load in Tally Prime:
;;    1. Save the file from the URL above to a folder every Tally user
;;       can read (on the hosted VM: paste via Notepad into a shared
;;       folder, e.g. TALLYBACKUP\mickys-stock.tdl).
;;    2. F1 (Help) > TDLs & AddOns > F4 (Manage Local TDLs) > "Load
;;       selected TDL files on startup" = Yes > enter the file's full
;;       path > Ctrl+A to save. Restart Tally.
;;
;;  NOTE: the repo copy of this file is a template - the CRM backend
;;  fills the sync-key placeholder in MickysSyncURL when serving it.
;;  The template is not loadable as-is; download from the URL above
;;  (or fill the key in by hand).
;;
;;  How to query it:
;;    POST tally/sample-stock-request.xml to http://<tally-pc>:9001
;;    (see tally/README.md for the exact commands)
;; =====================================================================

;; ---- Optional menu entry: view the report inside Tally itself -------
[#Menu: Gateway of Tally]
    Add : Key Item : Mickys Stock Export : M : Display : MickysStockReport
    Add : Key Item : Mickys CRM Orders   : J : Display : MickysCrmSalesOrders

;; ---------------- Push to Mickys CRM (Sync button) --------------------
;; The key in the URL must match the TALLY_SYNC_KEY environment variable on
;; the CRM backend (Railway). With the report open, click "Sync to CRM" in
;; the right-hand button bar (or press Ctrl+F10) to send the current stock
;; position to the CRM over HTTPS. (Alt+Z is reserved by TallyPrime for the
;; Exchange menu, so the shortcut is Ctrl+F10.)
[System: Formula]
    MickysSyncURL : "https://api.mickys-crm.centrepointgroup.in/api/stock/sync?key={{TALLY_SYNC_KEY}}"

[Button: MickysSyncBtn]
    Key    : Ctrl + F10
    Title  : "Sync to CRM"
    Action : HTTP Post : @@MickysSyncURL : ASCII : MickysStockReport

;; ---- Hands-free sync: on company open + every 10 minutes -------------
;; Two triggers fire the same HTTP push automatically:
;;   1. Load Company - each time this company is opened in Tally, so the
;;      CRM gets fresh stock first thing without anyone pressing anything.
;;   2. MickysSyncTimer - repeats the push every 10 minutes for as long
;;      as Tally stays open. This matters twice over on the hosted setup:
;;      sessions keep the company open 24x7 (Load Company never re-fires),
;;      and SWITCHING to this company when a different one opened first
;;      fires no TDL event at all - the next tick is what picks it up.
;; Events invoke a function (CALL) rather than running HTTP Post directly
;; - the direct form works on buttons but can silently do nothing in an
;; event context. The guard matches only the first 12 characters of the
;; company name ("CENTRE POINT") so wording differences like PVT LTD vs
;; PRIVATE LIMITED never break it, while other companies still never push
;; their data to the CRM. The same guard also makes a timer tick a no-op
;; whenever no company is loaded (##SVCurrentCompany is empty then), so
;; the timer is safe to leave running. The backend independently refuses
;; payloads whose <COMPANY> is not CENTRE POINT*, so even a push fired
;; with the wrong company active can never overwrite Mickys stock.
[Function: MickysPushToCrm]
    00 : HTTP Post : @@MickysSyncURL : ASCII : MickysStockReport
    10 : CALL : MickysCrmOrdersRun

;; Both 0- and 1-based positions are checked because $$StringPart's start
;; index differs across releases - either match passes the guard.
;;
;; TallyPrime has no [Timer: ...] definition type (loading one fails with
;; T0006 "definition type is misspelt or incorrect"). A timer exists only
;; through events: the label of a TIMER event names it, and the action
;; "Start Timer : <name> : <seconds>" creates and starts it - done here on
;; System Start, so the clock begins the moment Tally launches.
[System: Events]
    MickysAutoSync   : Load Company : ($$StringPart:##SVCurrentCompany:0:12 = "CENTRE POINT") OR ($$StringPart:##SVCurrentCompany:1:12 = "CENTRE POINT") : CALL : MickysPushToCrm
    MickysSyncTimer  : TIMER        : ($$StringPart:##SVCurrentCompany:0:12 = "CENTRE POINT") OR ($$StringPart:##SVCurrentCompany:1:12 = "CENTRE POINT") : CALL : MickysPushToCrm
    MickysStartTimer : System Start : TRUE : Start Timer : MickysSyncTimer : 600

;; --------------------------- Report shell ----------------------------
[Report: MickysStockReport]
    Forms : MickysStockForm
    Title : "Mickys Stock Export"

[Form: MickysStockForm]
    Parts   : MickysCompanyPart, MickysStockPart, MickysVendorPart, MickysCustomerPart, MickysInvoicePart
    Buttons : MickysSyncBtn
    XMLTag  : "MICKYSSTOCK"

;; Which company produced this export - lets the backend refuse a payload
;; from any company other than CENTRE POINT* (several companies live on
;; this Tally, and the Ctrl+F10 button carries no company guard).
[Part: MickysCompanyPart]
    Lines : MickysCompanyLine

[Line: MickysCompanyLine]
    Fields : MickysCompanyField, MickysTdlVersionField

[Field: MickysCompanyField]
    Type   : String
    Set as : ##SVCurrentCompany
    XMLTag : "COMPANY"

;; Which version of this file produced the push - filled in by the CRM when
;; it serves the file. The CRM's reply to a push (and its Invoicing page)
;; says whether the loaded copy is current, so "is the new TDL actually
;; loaded on the Tally machine?" is never a guess again.
[Field: MickysTdlVersionField]
    Type   : String
    Set as : "{{TDL_VERSION}}"
    XMLTag : "TDLVERSION"

[Part: MickysStockPart]
    Lines    : MickysStockLine
    Repeat   : MickysStockLine : MickysStockItems
    Scrolled : Vertical

;; One repeated line per stock item -> one <STOCKITEM> element each
[Line: MickysStockLine]
    Fields : MSItemName, MSItemAlias, MSItemPartNo
    Fields : MSItemGroup, MSItemCategory, MSItemUnits
    Fields : MSOpeningQty, MSOpeningRate, MSOpeningValue
    Fields : MSInwardQty, MSInwardValue
    Fields : MSOutwardQty, MSOutwardValue
    Fields : MSClosingQty, MSClosingRate, MSClosingValue
    Fields : MSStdCost, MSStdPrice
    Fields : MSLastSaleRate, MSLastPurchaseRate
    XMLTag : "STOCKITEM"

;; ----------------------------- Fields --------------------------------
[Field: MSItemName]
    Type   : String
    Set as : $Name
    XMLTag : "NAME"

;; The item's alias - the "(alias)" line under the name on the Stock Item
;; master. Mickys keeps the CRM product code there (SFG-<item no>-<grams>,
;; e.g. SFG-006-250), so the CRM reads ALIAS as the item's code and matches
;; it to the stock row. $OnlyAlias returns the first alias only; an item
;; with no alias exports an empty tag.
[Field: MSItemAlias]
    Type   : String
    Set as : $OnlyAlias
    XMLTag : "ALIAS"

;; Tally's own "Part No." field (F12 > "Use part numbers for stock items").
;; Sent as a fallback: the CRM uses it as the code only when ALIAS is empty,
;; so either place works for entering codes. Empty when not maintained.
[Field: MSItemPartNo]
    Type   : String
    Set as : $PartNo
    XMLTag : "PARTNO"

[Field: MSItemGroup]
    Type   : String
    Set as : $Parent
    XMLTag : "GROUP"

[Field: MSItemCategory]
    Type   : String
    Set as : $Category
    XMLTag : "CATEGORY"

[Field: MSItemUnits]
    Type   : String
    Set as : $BaseUnits
    XMLTag : "BASEUNITS"

;; Opening position (as on SVFROMDATE)
[Field: MSOpeningQty]
    Type   : Quantity
    Set as : $OpeningBalance
    XMLTag : "OPENINGQTY"

[Field: MSOpeningRate]
    Type   : Rate
    Set as : $OpeningRate
    XMLTag : "OPENINGRATE"

[Field: MSOpeningValue]
    Type   : Amount
    Set as : $OpeningValue
    XMLTag : "OPENINGVALUE"

;; Movement within SVFROMDATE..SVTODATE
[Field: MSInwardQty]
    Type   : Quantity
    Set as : $InwardQuantity
    XMLTag : "INWARDQTY"

[Field: MSInwardValue]
    Type   : Amount
    Set as : $InwardValue
    XMLTag : "INWARDVALUE"

[Field: MSOutwardQty]
    Type   : Quantity
    Set as : $OutwardQuantity
    XMLTag : "OUTWARDQTY"

[Field: MSOutwardValue]
    Type   : Amount
    Set as : $OutwardValue
    XMLTag : "OUTWARDVALUE"

;; Closing position (as on SVTODATE)
[Field: MSClosingQty]
    Type   : Quantity
    Set as : $ClosingBalance
    XMLTag : "CLOSINGQTY"

[Field: MSClosingRate]
    Type   : Rate
    Set as : $ClosingRate
    XMLTag : "CLOSINGRATE"

[Field: MSClosingValue]
    Type   : Amount
    Set as : $ClosingValue
    XMLTag : "CLOSINGVALUE"

;; Pricing masters (value applicable as on date, if maintained)
[Field: MSStdCost]
    Type   : Rate
    Set as : $StandardCost
    XMLTag : "STANDARDCOST"

[Field: MSStdPrice]
    Type   : Rate
    Set as : $StandardPrice
    XMLTag : "STANDARDPRICE"

;; Last actual transaction rates (from vouchers) - the practical selling
;; price / purchase cost even when standard rates are not maintained in
;; the item master. If a release doesn't expose these methods they just
;; export empty - the report still loads.
[Field: MSLastSaleRate]
    Type   : Rate
    Set as : $LastSalePrice
    XMLTag : "LASTSALEPRICE"

[Field: MSLastPurchaseRate]
    Type   : Rate
    Set as : $LastPurchaseCost
    XMLTag : "LASTPURCHASECOST"

;; --------------------------- Collection ------------------------------
[Collection: MickysStockItems]
    Type  : Stock Item
    Fetch : Name, OnlyAlias, PartNo, Parent, Category, BaseUnits
    Fetch : OpeningBalance, OpeningRate, OpeningValue
    Fetch : ClosingBalance, ClosingRate, ClosingValue
    Fetch : StandardCost, StandardPrice
    Fetch : LastSalePrice, LastPurchaseCost

;; ------------------------ Vendors (suppliers) -------------------------
;; Every ledger under Sundry Creditors (sub-groups included) -> one
;; <VENDOR> element with name and group. "Sundry Creditors" is one of
;; Tally's built-in groups, so this needs no per-company configuration.
[Part: MickysVendorPart]
    Lines    : MickysVendorLine
    Repeat   : MickysVendorLine : MickysVendors
    Scrolled : Vertical

[Line: MickysVendorLine]
    Fields : MVName, MVGroup
    XMLTag : "VENDOR"

[Field: MVName]
    Type   : String
    Set as : $Name
    XMLTag : "NAME"

[Field: MVGroup]
    Type   : String
    Set as : $Parent
    XMLTag : "GROUP"

[Collection: MickysVendors]
    Type       : Ledger
    Child Of   : "Sundry Creditors"
    Belongs To : Yes
    Fetch      : Name, Parent

;; ------------------------ Customers (buyers) --------------------------
;; Every ledger under Sundry Debtors (sub-groups included) -> one
;; <CUSTOMER> element with name and group. "Sundry Debtors" is also a
;; built-in group, so no per-company configuration needed.
[Part: MickysCustomerPart]
    Lines    : MickysCustomerLine
    Repeat   : MickysCustomerLine : MickysCustomers
    Scrolled : Vertical

[Line: MickysCustomerLine]
    Fields : MCName, MCGroup
    XMLTag : "CUSTOMER"

[Field: MCName]
    Type   : String
    Set as : $Name
    XMLTag : "NAME"

[Field: MCGroup]
    Type   : String
    Set as : $Parent
    XMLTag : "GROUP"

[Collection: MickysCustomers]
    Type       : Ledger
    Child Of   : "Sundry Debtors"
    Belongs To : Yes
    Fetch      : Name, Parent

;; ------------------------ Sales invoices ------------------------------
;; Recent vouchers of the voucher type named "Sales" -> one <SALESINVOICE>
;; element each. Only that exact type: voucher types created under Sales
;; (RENTAL INCOME, FILLING & RETORTING INCOME) are not product sales and
;; are left out, as are credit notes. The CRM looks for its sales order
;; number (SO-YYYY-NNNN) in ORDERNOS (the invoice's "Order No(s)" field),
;; REFERENCE (the "Ref" beside the voucher number) or NARRATION - accounts
;; write it in any one of them when keying the invoice - and moves the
;; matched order to Invoiced. Only the last 60 days are sent so the
;; payload stays small; cancelled and optional vouchers are skipped. DATE
;; is exported as YYYYMMDD.
[Part: MickysInvoicePart]
    Lines    : MickysInvoiceLine
    Repeat   : MickysInvoiceLine : MickysSalesInvoices
    Scrolled : Vertical

[Line: MickysInvoiceLine]
    Fields  : MIGuid, MIVchNo, MIVchType, MIDate, MIParty
    Fields  : MIReference, MIOrderNos, MINarration
    Fields  : MIAmount, MIBasicValue, MIItemValue, MITax
    XMLTag  : "SALESINVOICE"
    Explode : MickysLedgerPart : Yes

;; The voucher's ledger entries, one <LEDGERENTRY> each nested inside its
;; <SALESINVOICE>: ledger name, its group and top-level group, amount. No
;; total functions involved, so the CRM can add up the Sales Accounts
;; entries itself (basic value) and the Duties & Taxes entries (GST) when
;; the summed fields above come back empty on a release.
[Part: MickysLedgerPart]
    Lines    : MickysLedgerLine
    Repeat   : MickysLedgerLine : AllLedgerEntries
    Scrolled : Vertical

[Line: MickysLedgerLine]
    Fields : MLName, MLGroup, MLPrimaryGroup, MLAmount
    XMLTag : "LEDGERENTRY"

[Field: MLName]
    Type   : String
    Set as : $LedgerName
    XMLTag : "NAME"

[Field: MLGroup]
    Type   : String
    Set as : $Parent:Ledger:$LedgerName
    XMLTag : "GROUP"

[Field: MLPrimaryGroup]
    Type   : String
    Set as : $_PrimaryGroup:Ledger:$LedgerName
    XMLTag : "PRIMARYGROUP"

[Field: MLAmount]
    Type   : Amount
    Set as : $Amount
    XMLTag : "AMOUNT"

[Field: MIGuid]
    Type   : String
    Set as : $GUID
    XMLTag : "GUID"

[Field: MIVchNo]
    Type   : String
    Set as : $VoucherNumber
    XMLTag : "VOUCHERNUMBER"

[Field: MIVchType]
    Type   : String
    Set as : $VoucherTypeName
    XMLTag : "VOUCHERTYPE"

[Field: MIDate]
    Type   : String
    Set as : $$String:$Date:UniversalDate
    XMLTag : "DATE"

[Field: MIParty]
    Type   : String
    Set as : $PartyLedgerName
    XMLTag : "PARTY"

[Field: MIReference]
    Type   : String
    Set as : $Reference
    XMLTag : "REFERENCE"

;; The "Order No(s)" entered on the invoice's party details screen -
;; comma-separated when there are several.
[Field: MIOrderNos]
    Type   : String
    Set as : $$FullList:InvoiceOrderList:BasicPurchaseOrderNo
    XMLTag : "ORDERNOS"

[Field: MINarration]
    Type   : String
    Set as : $Narration
    XMLTag : "NARRATION"

;; Invoice total as billed (party ledger amount, GST and round-off included).
[Field: MIAmount]
    Type   : Amount
    Set as : $Amount
    XMLTag : "AMOUNT"

;; Basic value before GST - the "Basic Value" / "Sales A/c" column of
;; Tally's sales register - sent three ways, because which method a
;; release evaluates correctly differs; the CRM keeps whichever arrives:
;;   BASICVALUE  total of the voucher's ledger entries under Sales Accounts
;;   ITEMVALUE   total of the voucher's item lines (the register's "Value")
;;   TAX         total of its Duties & Taxes ledger entries (CGST + SGST),
;;               from which basic = AMOUNT - TAX when the other two are empty
[Field: MIBasicValue]
    Type   : Amount
    Set as : $$FilterAmtTotal:AllLedgerEntries:MickysIsSalesLedger:Amount
    XMLTag : "BASICVALUE"

[Field: MIItemValue]
    Type   : Amount
    Set as : $$CollAmtTotal:AllInventoryEntries:Amount
    XMLTag : "ITEMVALUE"

[Field: MITax]
    Type   : Amount
    Set as : $$FilterAmtTotal:AllLedgerEntries:MickysIsTaxLedger:Amount
    XMLTag : "TAX"

;; The ledger and item sub-entries must be fetched too: the basic-value and
;; tax totals above are summed over them, and a voucher collection with an
;; explicit Fetch list carries only what it names.
[Collection: MickysSalesInvoices]
    Type   : Voucher
    Filter : MickysIsSalesVch
    Fetch  : Date, VoucherNumber, VoucherTypeName, PartyLedgerName
    Fetch  : Reference, Narration, Amount, GUID, IsCancelled, IsOptional
    Fetch  : AllLedgerEntries.*, AllInventoryEntries.*

[System: Formula]
    MickysInvoiceFrom   : $$MachineDate - 60
    MickysIsSalesVch    : ($VoucherTypeName = "Sales") AND (NOT $IsCancelled) AND (NOT $IsOptional) AND ($Date >= @@MickysInvoiceFrom)
    MickysIsSalesLedger : $$IsLedOfGrp:$LedgerName:$$GroupSales
    MickysIsTaxLedger   : $$IsLedOfGrp:$LedgerName:"Duties & Taxes"

;; =====================================================================
;;  Sales orders: CRM -> Tally
;; ---------------------------------------------------------------------
;;  Confirmed CRM orders become Sales Order vouchers here, built the way the
;;  company's own orders are (proven on this Tally with a one-off test
;;  add-on, SO/26-27/246): Tally's own number, Order no. = CRM number,
;;  godown from the CRM settings with batch "Any" (the batch is picked at
;;  invoicing), Sales A/c on each item, CGST/SGST (or IGST) and round-off as
;;  ledger lines. The CRM side is server/src/services/tallyOrder.service.js.
;; =====================================================================

[System: Formula]
    MickysOrdersFeedURL   : "https://api.mickys-crm.centrepointgroup.in/api/stock/tally-orders?claim=1&key={{TALLY_SYNC_KEY}}"
    MickysOrdersSampleURL : "https://api.mickys-crm.centrepointgroup.in/api/stock/tally-orders?sample=1&key={{TALLY_SYNC_KEY}}"
    MickysOrdersSeenURL   : "https://api.mickys-crm.centrepointgroup.in/api/stock/tally-orders/seen?key={{TALLY_SYNC_KEY}}"
    MickysOrdersFrom      : $$MachineDate - 60
    MickysIsCrmSalesOrder : ($VoucherTypeName = "{{VOUCHER_TYPE}}") AND (NOT $IsCancelled) AND (NOT $IsOptional) AND ($Date >= @@MickysOrdersFrom)

;; Buttons on the "Mickys CRM Orders" report (also clickable in the
;; right-hand button bar).
[Button: MickysCrmPullBtn]
    Key    : Ctrl + F9
    Title  : "Get CRM orders"
    Action : Call : MickysCrmOrdersRun

[Button: MickysCrmSampleBtn]
    Key    : Ctrl + Alt + S
    Title  : "Sample order"
    Action : Call : MickysCrmSampleRun

[Button: MickysCrmFeedCheckBtn]
    Key    : Ctrl + Alt + F
    Title  : "Check feed"
    Action : Display : MickysCrmFeedCheck

;; Runs after every stock push (Load Company + the 10-minute timer) and on
;; "Get CRM orders" in the "Mickys CRM Orders" report. Report first, then
;; collect: the CRM hands out only orders Tally does not already hold, so
;; what it learns from the report keeps it from handing out an order twice.
[Function: MickysCrmOrdersRun]
    00 : IF : NOT (($$StringPart:##SVCurrentCompany:0:12 = "CENTRE POINT") OR ($$StringPart:##SVCurrentCompany:1:12 = "CENTRE POINT"))
    01 :    RETURN
    02 : END IF
    10 : HTTP Post : @@MickysOrdersSeenURL : ASCII : MickysCrmSalesOrders
    20 : CALL : MickysCrmCreateOrders : "MickysCrmOrderFeed"

;; "Sample order": the CRM's fixed TEST sample (party TEST, Order no.
;; TEST/SAMPLE-hhmm), built by the same function as real orders - for
;; checking the Tally side without touching a real CRM order.
[Function: MickysCrmSampleRun]
    00 : IF : NOT (($$StringPart:##SVCurrentCompany:0:12 = "CENTRE POINT") OR ($$StringPart:##SVCurrentCompany:1:12 = "CENTRE POINT"))
    01 :    RETURN
    02 : END IF
    10 : CALL : MickysCrmCreateOrders : "MickysCrmSampleFeed"

;; ---------------- Creating the orders the CRM hands out ----------------
;; The CRM sends one flat <ROW> per step: HEAD starts a voucher, ITEM adds an
;; item line (godown, batch Any, Order no., due date, sales ledger), PARTY /
;; CREDIT / DEBIT add a ledger line, END saves the voucher. Every amount in
;; the feed is positive; the sign and the Yes/No flags go with the row kind
;; and are written here as literals. During the walk the row is the current
;; object, so its fields are plain $ methods (Tally Help FAQ 6520: the source
;; context stays the walked row while the voucher is the target).
;; A feed collection is referenced once only - every reference fetches it
;; again, and the CRM hands each order out once.
[Collection: MickysCrmOrderFeed]
    Remote URL      : @@MickysOrdersFeedURL
    XML Object Path : ROW : 1 : MICKYSORDERS

[Collection: MickysCrmSampleFeed]
    Remote URL      : @@MickysOrdersSampleURL
    XML Object Path : ROW : 1 : MICKYSORDERS

;; Every step below uses a form proven on the company's Tally with the one-off
;; test add-on (SO/26-27/246):
;;   - the view in BOTH the SVViewName variable and PersistedView ("Invoice
;;     Voucher View"), else Tally saves the order without its item lines
;;     (TDL FAQ "No Entries in Voucher");
;;   - quantity and rate as numbers converted in the item line's context
;;     ($$TGTObject:$$AsQty / $$AsRate), never text such as "1 Nos";
;;   - outward quantity negative, else it shows "(-)1 Nos";
;;   - the due date through $$DateRange; order and due date = today.
[Function: MickysCrmCreateOrders]
    Parameter : MCRFeed    : String
    Variable  : SVViewName : String
    Variable  : MCRQty     : Number
    Variable  : MCRRate    : Number
    Variable  : MCRAmt     : Number

    00 : SET : SVViewName : "Invoice Voucher View"
    01 : WALK COLLECTION : ##MCRFeed
    10 :    IF : $KIND = "HEAD"
    11 :       NEW OBJECT : Voucher
    12 :       SET VALUE  : PersistedView      : ##SVViewName
    13 :       SET VALUE  : Date               : $$MachineDate
    14 :       SET VALUE  : VoucherTypeName    : $VCHTYPE
    15 :       SET VALUE  : PartyLedgerName    : $PARTY
    16 :       SET VALUE  : PartyName          : $PARTY
    17 :       SET VALUE  : BasicBuyerName     : $PARTY
    18 :       SET VALUE  : BasicBasePartyName : $PARTY
    19 :       SET VALUE  : Reference          : $ORDERNO
    20 :       SET VALUE  : Narration          : $NARRATION
    21 :       SET VALUE  : IsInvoice          : No
    22 :    END IF
    30 :    IF : $KIND = "ITEM"
    31 :       SET        : MCRQty           : 0 - $$Number:$QTY
    32 :       SET        : MCRRate          : $$Number:$RATE
    33 :       SET        : MCRAmt           : $$Number:$AMOUNT
    34 :       INSERT COLLECTION OBJECT : AllInventoryEntries
    35 :       SET VALUE  : StockItemName    : $ITEM
    36 :       SET VALUE  : IsDeemedPositive : No
    37 :       SET VALUE  : Rate             : $$TGTObject:$$AsRate:##MCRRate
    38 :       SET VALUE  : ActualQty        : $$TGTObject:$$AsQty:##MCRQty
    39 :       SET VALUE  : BilledQty        : $$TGTObject:$$AsQty:##MCRQty
    40 :       SET VALUE  : Amount           : ##MCRAmt
    41 :       INSERT COLLECTION OBJECT : BatchAllocations
    42 :       SET VALUE  : GodownName       : $GODOWN
    43 :       SET VALUE  : BatchName        : $$SysName:Any
    44 :       SET VALUE  : OrderNo          : $ORDERNO
    45 :       SET VALUE  : Amount           : ##MCRAmt
    46 :       SET VALUE  : ActualQty        : $$TGTObject:$$AsQty:##MCRQty
    47 :       SET VALUE  : BilledQty        : $$TGTObject:$$AsQty:##MCRQty
    48 :       SET VALUE  : OrderDueDate     : $$DateRange:($$String:$$MachineDate):$$MachineDate:True
    49 :       SET TARGET : ..
    50 :       INSERT COLLECTION OBJECT : AccountingAllocations
    51 :       SET VALUE  : LedgerName       : $LEDGER
    52 :       SET VALUE  : IsDeemedPositive : No
    53 :       SET VALUE  : Amount           : ##MCRAmt
    54 :       SET TARGET : ..
    55 :       SET TARGET : ..
    56 :    END IF
    60 :    IF : $KIND = "PARTY"
    61 :       SET        : MCRAmt           : 0 - $$Number:$AMOUNT
    62 :       INSERT COLLECTION OBJECT : LedgerEntries
    63 :       SET VALUE  : LedgerName       : $LEDGER
    64 :       SET VALUE  : IsDeemedPositive : Yes
    65 :       SET VALUE  : IsPartyLedger    : Yes
    66 :       SET VALUE  : Amount           : ##MCRAmt
    67 :       SET TARGET : ..
    68 :    END IF
    70 :    IF : $KIND = "CREDIT"
    71 :       SET        : MCRAmt           : $$Number:$AMOUNT
    72 :       INSERT COLLECTION OBJECT : LedgerEntries
    73 :       SET VALUE  : LedgerName       : $LEDGER
    74 :       SET VALUE  : IsDeemedPositive : No
    75 :       SET VALUE  : Amount           : ##MCRAmt
    76 :       SET TARGET : ..
    77 :    END IF
    80 :    IF : $KIND = "DEBIT"
    81 :       SET        : MCRAmt           : 0 - $$Number:$AMOUNT
    82 :       INSERT COLLECTION OBJECT : LedgerEntries
    83 :       SET VALUE  : LedgerName       : $LEDGER
    84 :       SET VALUE  : IsDeemedPositive : Yes
    85 :       SET VALUE  : Amount           : ##MCRAmt
    86 :       SET TARGET : ..
    87 :    END IF
    90 :    IF : $KIND = "END"
    91 :       CREATE TARGET
    92 :    END IF
    99 : END WALK

;; ---------------- Tally's sales orders, reported to the CRM ------------
;; Shown on screen from Gateway of Tally, and posted to the CRM as XML by
;; MickysCrmOrdersRun: one <SALESORDER> per sales order of the last 60 days.
[Report: MickysCrmSalesOrders]
    Forms : MickysCrmSOForm
    Title : "Mickys CRM - Sales Orders in Tally"

[Form: MickysCrmSOForm]
    Parts   : MickysCrmSOHead, MickysCrmSOList
    Buttons : MickysCrmPullBtn, MickysCrmSampleBtn, MickysCrmFeedCheckBtn
    XMLTag  : "MICKYSSALESORDERS"

[Part: MickysCrmSOHead]
    Lines : MickysCrmSOHeadLine

[Line: MickysCrmSOHeadLine]
    Fields : MickysCrmSOCompany, MickysCrmSOVersion

[Field: MickysCrmSOCompany]
    Type   : String
    Set as : ##SVCurrentCompany
    XMLTag : "COMPANY"

[Field: MickysCrmSOVersion]
    Type   : String
    Set as : "{{TDL_VERSION}}"
    XMLTag : "TDLVERSION"

[Part: MickysCrmSOList]
    Lines    : MickysCrmSOLine
    Repeat   : MickysCrmSOLine : MickysCrmTallyOrders
    Scrolled : Vertical

[Line: MickysCrmSOLine]
    Fields : MCSVchNo, MCSDate, MCSParty, MCSRef, MCSNarration, MCSGuid
    XMLTag : "SALESORDER"

[Field: MCSVchNo]
    Type   : String
    Set as : $VoucherNumber
    XMLTag : "VOUCHERNUMBER"

[Field: MCSDate]
    Type   : String
    Set as : $$String:$Date:UniversalDate
    XMLTag : "DATE"

[Field: MCSParty]
    Type   : String
    Set as : $PartyLedgerName
    XMLTag : "PARTY"

;; The sales order's "Order no." - the CRM number on orders the CRM created.
[Field: MCSRef]
    Type   : String
    Set as : $Reference
    XMLTag : "REFERENCE"

[Field: MCSNarration]
    Type   : String
    Set as : $Narration
    XMLTag : "NARRATION"

[Field: MCSGuid]
    Type   : String
    Set as : $GUID
    XMLTag : "GUID"

[Collection: MickysCrmTallyOrders]
    Type   : Voucher
    Filter : MickysIsCrmSalesOrder
    Fetch  : Date, VoucherNumber, VoucherTypeName, PartyLedgerName
    Fetch  : Reference, Narration, GUID, IsCancelled, IsOptional

;; ---------------- "Check feed": the sample order as Tally reads it --------
;; Shows the rows of the CRM's sample feed exactly as this Tally parses them -
;; if "Sample order" creates nothing, this says whether the feed arrives.
[Report: MickysCrmFeedCheck]
    Forms : MickysCrmFeedCheckForm
    Title : "Mickys CRM - sample order as Tally reads it"

[Form: MickysCrmFeedCheckForm]
    Parts : MickysCrmFeedCheckPart

[Part: MickysCrmFeedCheckPart]
    Lines    : MickysCrmFeedCheckTitle, MickysCrmFeedCheckLine
    Repeat   : MickysCrmFeedCheckLine : MickysCrmSampleFeed
    Scrolled : Vertical

[Line: MickysCrmFeedCheckTitle]
    Fields : MFCKindT, MFCOrderT, MFCItemT, MFCQtyT, MFCRateT, MFCAmtT, MFCLedgerT

[Line: MickysCrmFeedCheckLine]
    Fields : MFCKind, MFCOrder, MFCItem, MFCQty, MFCRate, MFCAmt, MFCLedger

[Field: MFCKindT]
    Use    : Name Field
    Set as : "Row"
    Width  : 8

[Field: MFCOrderT]
    Use    : Name Field
    Set as : "Order no."
    Width  : 22

[Field: MFCItemT]
    Use    : Name Field
    Set as : "Item / party"
    Width  : 32

[Field: MFCQtyT]
    Use    : Name Field
    Set as : "Qty"
    Width  : 6

[Field: MFCRateT]
    Use    : Name Field
    Set as : "Rate"
    Width  : 10

[Field: MFCAmtT]
    Use    : Name Field
    Set as : "Amount"
    Width  : 10

[Field: MFCLedgerT]
    Use    : Name Field
    Set as : "Ledger / godown"
    Width  : 30

[Field: MFCKind]
    Use    : Name Field
    Set as : $KIND
    Width  : 8

[Field: MFCOrder]
    Use    : Name Field
    Set as : $ORDERNO
    Width  : 22

[Field: MFCItem]
    Use    : Name Field
    Set as : if $KIND = "ITEM" then $ITEM else $PARTY
    Width  : 32

[Field: MFCQty]
    Use    : Name Field
    Set as : $QTY
    Width  : 6

[Field: MFCRate]
    Use    : Name Field
    Set as : $RATE
    Width  : 10

[Field: MFCAmt]
    Use    : Name Field
    Set as : $AMOUNT
    Width  : 10

[Field: MFCLedger]
    Use    : Name Field
    Set as : if $KIND = "ITEM" then $GODOWN + " / " + $LEDGER else $LEDGER
    Width  : 30
